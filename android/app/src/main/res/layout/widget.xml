<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- warm grained paper -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/paper_tile" />

    <!-- theme colour laid over the paper grain -->
    <FrameLayout
        android:id="@+id/tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- the polaroid always fits whole, whatever the widget's shape -->
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_desc"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="✎  Scribbles"
            android:textColor="#7A6E62"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:text="Nothing yet"
            android:textColor="#1F1B18"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Open Scribbles and paste your personal link."
            android:textColor="#7A6E62"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:alpha="0.75"
        android:background="@drawable/pill_bg"
        android:padding="7dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="Refresh" />
</FrameLayout>
