<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textStyle="bold|italic"
            android:text="Scribbles"
            android:textColor="@color/ink"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="Settings. Your link connects this phone to Scribbles: the drawing app, the widget and notifications."
            android:textColor="@color/soft"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Your personal link"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="https://…vercel.app/u/…"
            android:inputType="textUri"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/paste"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_light"
                android:stateListAnimator="@null"
                android:text="Paste"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/save"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:background="@drawable/btn_dark"
                android:stateListAnimator="@null"
                android:text="Connect"
                android:textAllCaps="false"
                android:textColor="@color/paper"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/soft"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/add_widget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/btn_dark"
            android:stateListAnimator="@null"
            android:text="Add widget to home screen"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/open"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_light"
                android:stateListAnimator="@null"
                android:text="Back to Scribbles"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/refresh_now"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/btn_light"
                android:stateListAnimator="@null"
                android:text="Refresh now"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="3dp"
            android:text="The widget checks for new doodles about every 15 minutes, and instantly when you tap ↻ on it. If it stops updating, go to Settings → Apps → Scribbles → Battery and allow background activity."
            android:textColor="@color/soft"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
