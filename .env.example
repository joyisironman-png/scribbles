# Upstash Redis (or Vercel KV names: KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Personal keys: each person's private link is https://<your-app>/u/<KEY>
JOY_KEY=
VIDYA_KEY=

# Optional display names
JOY_NAME=Joy
VIDYA_NAME=Vidya

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
